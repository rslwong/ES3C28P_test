// secrets.h.example  -  camera address + RTSP login for ES3C28P_cam_idf.
//
//   cp main/secrets.h.example main/secrets.h   (secrets.h is gitignored)
//
// The login is the Tapo "Camera Account" (Tapo app -> camera -> Settings ->
// Advanced Settings -> Camera Account), not your TP-Link cloud login.
//
// WiFi is read from the credentials ES3C28P_radio saved to NVS. To seed it here
// instead, also define WIFI_SSID / WIFI_PASS.
#pragma once

#define CAM_HOST "192.168.2.126"
#define CAM_USER "your-camera-account"
#define CAM_PASS "your-camera-password"
